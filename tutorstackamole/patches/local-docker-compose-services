############# guacd
guacd:
  image: {{ STACKAMOLE_GUACD_DOCKER_IMAGE }}
  restart: unless-stopped
  ports:
    - 4822:4822

############# stackamole-guacamole-client
stackamole-xblock:
  image: {{ STACKAMOLE_DOCKER_IMAGE }}
  environment:
    DJANGO_SETTINGS_MODULE: stackamole_guacamole_client.tutor.settings
  restart: unless-stopped
  ports:
    - "8085-8095:8095"
  volumes:
    - ../plugins/stackamole/apps/stackamole/settings:/stackamole-xblock/stackamole_guacamole_client/tutor:ro
  depends_on:
    - guacd
    - mysql
  deploy:
    replicas: {{ STACKAMOLE_REPLICA_COUNT }}

############# suspender
stackamole-xblock-suspender:
  image: {{ DOCKER_IMAGE_OPENEDX }}
  environment:
    SERVICE_VARIANT: lms
    SETTINGS: ${TUTOR_EDX_PLATFORM_SETTINGS:-tutor.production}
  command: ./manage.py lms suspender
  restart: unless-stopped
  volumes:
    # Settings & config
    - ../apps/openedx/settings/lms:/openedx/edx-platform/lms/envs/tutor:ro
    - ../apps/openedx/settings/cms:/openedx/edx-platform/cms/envs/tutor:ro
    - ../apps/openedx/config:/openedx/config:ro
    # editable requirements
    - ../build/openedx/requirements:/openedx/requirements
  depends_on:
    - lms
    {% if RUN_MYSQL %}- mysql{% endif %}
    {% if RUN_REDIS %}- redis{% endif %}
  deploy:
    replicas: {% if STACKAMOLE_ENABLE_SUSPENDER %}1{% else %}0{% endif %}

############# reaper
stackamole-xblock-reaper:
  image: {{ DOCKER_IMAGE_OPENEDX }}
  environment:
    SERVICE_VARIANT: lms
    SETTINGS: ${TUTOR_EDX_PLATFORM_SETTINGS:-tutor.production}
  command: ./manage.py lms reaper
  restart: unless-stopped
  volumes:
    # Settings & config
    - ../apps/openedx/settings/lms:/openedx/edx-platform/lms/envs/tutor:ro
    - ../apps/openedx/settings/cms:/openedx/edx-platform/cms/envs/tutor:ro
    - ../apps/openedx/config:/openedx/config:ro
    # editable requirements
    - ../build/openedx/requirements:/openedx/requirements
  depends_on:
    - lms
    {% if RUN_MYSQL %}- mysql{% endif %}
    {% if RUN_REDIS %}- redis{% endif %}
  deploy:
    replicas: {% if STACKAMOLE_ENABLE_REAPER %}1{% else %}0{% endif %}

