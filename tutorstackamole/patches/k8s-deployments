---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: guacd
  labels:
    app.kubernetes.io/name: guacd
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: guacd
  template:
    metadata:
      labels:
        app.kubernetes.io/name: guacd
    spec:
      containers:
        - name: guacd
          image: {{ STACKAMOLE_GUACD_DOCKER_IMAGE }}
          ports:
            - containerPort: 4822

---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: stackamole-xblock
  labels:
    app.kubernetes.io/name: stackamole-xblock
spec:
  replicas: {{ STACKAMOLE_REPLICA_COUNT }}
  selector:
    matchLabels:
      app.kubernetes.io/name: stackamole-xblock
  template:
    metadata:
      labels:
        app.kubernetes.io/name: stackamole-xblock
    spec:
      containers:
        - name: stackamole-xblock
          image: {{ STACKAMOLE_DOCKER_IMAGE }}
          ports:
            - containerPort: 8095
          env:
            - name: DJANGO_SETTINGS_MODULE
              value: stackamole_guacamole_client.tutor.settings
          volumeMounts:
            - mountPath: /stackamole-xblock/stackamole_guacamole_client/tutor/settings.py
              name: settings
              subPath: settings.py
      volumes:
        - name: settings
          configMap:
            name: stackamole-settings
