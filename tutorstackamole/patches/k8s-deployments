---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: stackamole-xblock-suspender
  labels:
    app.kubernetes.io/name: stackamole-xblock-suspender
spec:
  replicas: {% if STACKAMOLE_ENABLE_SUSPENDER %}1{% else %}0{% endif %}
  selector:
    matchLabels:
      app.kubernetes.io/name: stackamole-xblock-suspender
  template:
    metadata:
      labels:
        app.kubernetes.io/name: stackamole-xblock-suspender
    spec:
      containers:
        - name: stackamole-xblock-suspender
          image: {{ DOCKER_IMAGE_OPENEDX }}
          args: ["./manage.py", "lms", "suspender"]
          volumeMounts:
            - mountPath: /openedx/edx-platform/lms/envs/tutor/
              name: settings-lms
            - mountPath: /openedx/edx-platform/cms/envs/tutor/
              name: settings-cms
            - mountPath: /openedx/config
              name: config
      volumes:
        - name: settings-lms
          configMap:
            name: openedx-settings-lms
        - name: settings-cms
          configMap:
            name: openedx-settings-cms
        - name: config
          configMap:
            name: openedx-config

